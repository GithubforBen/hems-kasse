# --- Database (PostgreSQL) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/kasse
SPRING_DATASOURCE_USERNAME=kasse
SPRING_DATASOURCE_PASSWORD=kasse

# --- JWT ---
# Generate with: openssl rand -base64 48
KASSE_JWT_SECRET=ZGV2LW9ubHktc2VjcmV0LXBsZWFzZS1jaGFuZ2UtbWUtMzItYnl0ZXMtbWluaW11bQ==
KASSE_JWT_TTL_HOURS=12

# --- Gruppen-Passwörter (Verkauf logins) ---
# Format: GRUPPE:passwort,GRUPPE:passwort
# A Verkäufer:in logs in with Gruppe + this password.
KASSE_GROUP_PASSWORDS=1:Passw0rd,2:Görner

# --- Admin users (per-user passwords) ---
# Format: user:passwort,user:passwort
KASSE_ADMIN_USERS=alice:adminPW1,bob:adminPW2

# --- EPC-QR / Girocode (SEPA Credit Transfer) ---
# Beneficiary used for the Karte stage. Amount is dynamic.
KASSE_EPC_NAME=Schulkasse Beispielschule
KASSE_EPC_IBAN=DE12500105170648489890
# BIC: leave blank for EEA recipients (recommended in EPC v002)
KASSE_EPC_BIC=
# Optional 4-character EPC purpose code (e.g. CHAR for charity); leave blank if unsure.
KASSE_EPC_PURPOSE=
# Default unstructured remittance text (≤ 140 chars). The current shift/timestamp may be appended.
KASSE_EPC_REMITTANCE=Kuchenverkauf

# --- CORS ---
# Comma-separated list of allowed origins for the Nuxt dev / prod frontend.
KASSE_CORS_ORIGINS=http://localhost:3000
