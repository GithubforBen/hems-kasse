# Copy to `.env` and edit. docker compose reads this automatically.
#
#   Local:  cp .env.example .env && docker compose up --build
#   Tunnel: cp .env.example .env  (fill in CF_* below)
#           docker compose --profile tunnel up --build
#

# ---------- Database ----------
POSTGRES_DB=kasse
POSTGRES_USER=kasse
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_HOST_PORT=5432

# ---------- Backend ----------
BACKEND_HOST_PORT=8080

# JWT signing key. Must be at least 32 bytes. Generate with:
#   openssl rand -base64 48
KASSE_JWT_SECRET=ZGV2LW9ubHktc2VjcmV0LXBsZWFzZS1jaGFuZ2UtbWUtMzItYnl0ZXMtbWluaW11bQ==
KASSE_JWT_TTL_HOURS=12

# Gruppen-Passwörter (Verkauf logins). Format: GRUPPE:passwort,GRUPPE:passwort
KASSE_GROUPS=1:Passw0rd,2:Görner

# Admin users (per-user passwords). Format: user:passwort,user:passwort
KASSE_ADMINS=alice:adminPW1,bob:adminPW2

# CORS allowlist (comma-separated). Add your production hostname here.
KASSE_CORS_ORIGINS=http://localhost:3000

# ---------- EPC-QR (Girocode) — beneficiary for the Karte stage ----------
KASSE_EPC_NAME=Schulkasse Beispielschule
KASSE_EPC_IBAN=DE89370400440532013000
# Optional. Leave blank for EEA beneficiaries.
KASSE_EPC_BIC=
# Optional 4-char EPC purpose code (e.g. CHAR). Leave blank if unsure.
KASSE_EPC_PURPOSE=
# Default unstructured remittance text (≤ 140 chars).
KASSE_EPC_REMITTANCE=Kuchenverkauf

# ---------- Frontend ----------
FRONTEND_HOST_PORT=3000
# Must be a URL the browser can reach. For multi-host deployments,
# replace with your public origin (e.g. https://kasse.example.org).
NUXT_PUBLIC_API_BASE=http://localhost:8080

# ---------- Cloudflare Tunnel (only needed with --profile tunnel) ----------
# 1. Install cloudflared locally:  https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/downloads/
# 2. Create a tunnel:              cloudflared tunnel login && cloudflared tunnel create schulkasse
# 3. Copy the credentials JSON to  cloudflared/creds.json
# 4. Edit cloudflared/config.yml:  set your tunnel ID and hostnames
# 5. Update the two vars below to match your hostnames, then run:
#       docker compose --profile tunnel up --build
#
# Example for kasse.example.com / api.kasse.example.com:
#   NUXT_PUBLIC_API_BASE=https://api.kasse.example.com
#   KASSE_CORS_ORIGINS=https://kasse.example.com
